<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

{% set pageTitle = title + " — " + site.title if title else site.title %}
{% set pageDescription = description if description else site.description %}
{% set ogImage = media[0].src | absoluteMediaUrl if media and media.length > 0 else "" %}
{% set pageUrl = (site.url | default("")) + page.url %}

<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">

<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:type" content="{{ 'article' if title else 'website' }}">
{% if site.url %}<meta property="og:url" content="{{ pageUrl }}">{% endif %}
{% if ogImage %}<meta property="og:image" content="{{ ogImage }}">{% endif %}

<meta name="twitter:card" content="{{ 'summary_large_image' if ogImage else 'summary' }}">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
{% if ogImage %}<meta name="twitter:image" content="{{ ogImage }}">{% endif %}

<link rel="stylesheet" href="/styles/main.css">
<link rel="stylesheet" href="/styles/custom.css">
<style>:root { --accent: {{ site.accent_color | default("#1a1a1a") }}; }</style>

{# Google Fonts, per page. A list of css2 family specs, e.g.
   fonts: ["Alegreya:ital,wght@0,400..900;1,400..900"] #}
{% if fonts %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{% for family in fonts %}
<link href="https://fonts.googleapis.com/css2?family={{ family }}&display=swap" rel="stylesheet">
{% endfor %}
{% endif %}

{# A bundled page script, from scripts/pages/<name>.js. Bundled by esbuild
   because browsers cannot resolve bare module specifiers like "three". #}
{% if script %}<script type="module" src="/js/{{ script }}.js"></script>{% endif %}

<!-- Prefetch same-origin pages on hover so cross-document view transitions
     land render-ready in Chrome (Safari/Arc already preload). -->
<script type="speculationrules">
{
  "prefetch": [
    { "source": "document", "where": { "href_matches": "/*" }, "eagerness": "moderate" }
  ]
}
</script>
