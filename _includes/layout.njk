<!DOCTYPE html>
<html lang="en">
<head>
  {% include "_head.njk" %}
</head>
<body>
  {% if entry %}
    <a href="{{ site.catalog_path }}" class="entry-back">&larr;</a>
  {% else %}
    <header class="site-header">
      <a href="{{ site.home_path }}" class="site-title">{{ site.title }}</a>
      {% if site.nav.length %}
        <nav class="site-nav">
          {% for item in site.nav %}
            <a href="{{ item.path }}">{{ item.label }}</a>
          {% endfor %}
        </nav>
      {% endif %}
    </header>
  {% endif %}

  <main>{{ content | safe }}</main>

  {% if not entry %}
    <footer class="site-footer">
      <p>{{ site.author }}</p>
    </footer>
  {% endif %}
</body>
</html>
